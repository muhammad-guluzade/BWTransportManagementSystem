[Unit]
Description=BW Departures: rebuild the stop database from NVBW
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=bw
Group=bw
WorkingDirectory=/srv/bw/app
ExecStart=/srv/bw/venv/bin/python import_stops.py
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
Nice=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/srv/bw/app/data
