# Settings of the public server (serve.py). Copy to .env and change there;
# .env is never committed.
BW_HOST=127.0.0.1
BW_PORT=8000
BW_THREADS=8
# Caddy in front, on the same machine. Needed: without it every visitor looks
# like 127.0.0.1 and all share one request limit (api/limits.py)
BW_PROXY=127.0.0.1
# The navigator (Route mode, journeys): on, or off for the departures app alone.
# A restart is needed after a change (systemctl restart bw-departures).
BW_NAVIGATOR=on
